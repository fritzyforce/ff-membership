# Salin ke .env.local lalu isi dari output `npm run db:start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY: hanya dipakai scripts/seed-dev.mjs. Jangan diberi prefix NEXT_PUBLIC_
# (akan ikut ter-bundle ke browser) dan jangan pernah dipakai di kode aplikasi.
SUPABASE_SERVICE_ROLE_KEY=
